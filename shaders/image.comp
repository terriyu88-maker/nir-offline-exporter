#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba32f) uniform readonly image2D u_in;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D u_out;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    vec4 c = imageLoad(u_in, p);
    imageStore(u_out, p, c);
}
